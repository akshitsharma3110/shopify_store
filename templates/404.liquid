<div class="page-not-found" style="min-height:60vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:40px 20px;">
  <div>
    <p style="font-size:80px;font-weight:800;color:var(--color-border);line-height:1;margin-bottom:16px;">404</p>
    <h1 style="font-size:clamp(1.5rem,3vw,2rem);font-weight:700;color:var(--color-primary);margin-bottom:12px;">
      {{ '404.heading' | t }}
    </h1>
    <p style="color:var(--color-muted);margin-bottom:32px;max-width:40ch;margin-left:auto;margin-right:auto;">
      {{ '404.message' | t }}
    </p>
    <a href="/" class="btn btn-primary btn-lg">{{ '404.cta' | t }}</a>
    <a href="/collections/all" class="btn btn-secondary btn-lg" style="margin-left:12px;">Browse Products</a>
  </div>
</div>
