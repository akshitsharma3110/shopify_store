{% comment %}
  Snippet: product-card.liquid
  Usage: {% render 'product-card', product: product %}
  Shows: image, category, title, price, MOQ, size options, quick-add
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_url = product.url
  assign featured_image = product.featured_image
  assign price = current_variant.price
  assign compare_price = current_variant.compare_at_price
  assign price_on_request = false
  if price == 0 or price == blank
    assign price_on_request = true
  endif
  assign product_type = product.type | downcase
  assign moq = product.metafields.custom.moq.value
  assign wa_number = settings.whatsapp_number | default: '919997100375'
  assign wa_msg = 'Hello! I am interested in ' | append: product.title | append: '. Please share details and pricing.'
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_msg | url_encode
-%}

<article class="product-card" aria-label="{{ product.title | escape }}">

  <!-- Image -->
  <div class="product-card-media">
    <a href="{{ product_url }}" tabindex="-1" aria-hidden="true">
      {%- if featured_image != blank -%}
        <img
          class="product-card-image"
          src="{{ featured_image | image_url: width: 600 }}"
          alt="{{ featured_image.alt | default: product.title | escape }}"
          width="600"
          height="600"
          loading="lazy"
        >
      {%- else -%}
        <div class="product-card-image" style="background-color:var(--color-bg);display:flex;align-items:center;justify-content:center;">
          <svg width="48" height="48" fill="none" stroke="var(--color-muted)" stroke-width="1" viewBox="0 0 24 24" opacity="0.4">
            <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9l4-4 4 4 4-4 4 4"/><circle cx="8.5" cy="15" r="1.5"/>
          </svg>
        </div>
      {%- endif -%}
    </a>

    <!-- Badges -->
    <div class="product-card-badge">
      {%- if product.compare_at_price > product.price and price_on_request == false -%}
        {%- assign savings_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round -%}
        <span class="badge badge-accent">{{ savings_pct }}% off</span>
      {%- endif -%}
    </div>

    <!-- Quick Add (visible on hover) -->
    <div class="product-card-quick-add">
      {%- if price_on_request -%}
        <a href="{{ wa_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm btn-full">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          Quote on WhatsApp
        </a>
      {%- elsif product.variants.size == 1 -%}
        <form method="post" action="/cart/add" data-product-form>
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="btn btn-primary btn-sm btn-full">
            {%- if current_variant.available -%}
              {{ 'products.quick_add' | t }}
            {%- else -%}
              {{ 'products.sold_out' | t }}
            {%- endif -%}
          </button>
        </form>
      {%- else -%}
        <a href="{{ product_url }}" class="btn btn-primary btn-sm btn-full">
          {{ 'products.view_product' | t }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <!-- Info -->
  <div class="product-card-info">
    {%- if product.type != blank -%}
      <p class="product-card-category">{{ product.type }}</p>
    {%- endif -%}

    <a href="{{ product_url }}" class="product-card-title">{{ product.title }}</a>

    <!-- Price -->
    {%- if price_on_request -%}
      <span class="price-on-request">{{ 'products.price_on_request' | t }}</span>
    {%- else -%}
      <div class="product-card-price">
        <span class="price-current">{{ price | money }}</span>
        {%- if compare_price > price -%}
          <span class="price-compare">{{ compare_price | money }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- MOQ -->
    {%- if moq != blank -%}
      <p class="product-card-moq">
        <span style="font-weight:600;color:var(--color-primary);">MOQ:</span> {{ moq }} pcs
      </p>
    {%- endif -%}

    <!-- Size dots -->
    {%- assign has_sizes = false -%}
    {%- for option in product.options -%}
      {%- if option == 'Size' -%}
        {%- assign has_sizes = true -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_sizes -%}
      <div class="product-card-sizes" aria-label="{{ 'products.sizes_label' | t }}">
        {%- for variant in product.variants -%}
          <span class="size-dot {% unless variant.available %}size-dot--disabled{% endunless %}"
            style="{% unless variant.available %}opacity:0.4;text-decoration:line-through;{% endunless %}">
            {{ variant.option1 }}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</article>
