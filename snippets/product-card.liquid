{% comment %}Snippet: product-card.liquid — Fashion card with swatches + quick-add hover{% endcomment %}

{%- assign first_variant = product.selected_or_first_available_variant -%}
{%- assign compare_price = first_variant.compare_at_price -%}
{%- assign actual_price = first_variant.price -%}
{%- assign on_sale = false -%}
{%- if compare_price > actual_price -%}{%- assign on_sale = true -%}{%- endif -%}

<article class="product-card" data-product-card>
  <!-- Media -->
  <div class="product-card-media">
    <a href="{{ product.url }}" aria-label="{{ product.title }}" tabindex="-1">
      {%- if product.featured_image -%}
        <img
          class="product-card-img"
          src="{{ product.featured_image | image_url: width: 540 }}"
          srcset="{{ product.featured_image | image_url: width: 360 }} 360w,
                  {{ product.featured_image | image_url: width: 540 }} 540w"
          sizes="(max-width: 480px) 50vw, (max-width: 900px) 33vw, 25vw"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          loading="lazy"
          width="540"
          height="720"
        >
        {%- assign second_media = product.media[1] -%}
        {%- if second_media -%}
          <img
            class="product-card-img-hover"
            src="{{ second_media | image_url: width: 540 }}"
            alt="{{ product.title | escape }}"
            loading="lazy"
          >
        {%- endif -%}
      {%- else -%}
        <div style="width:100%;height:100%;background:var(--color-surface);display:flex;align-items:center;justify-content:center;color:var(--color-border);">
          <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m8.5 8.5 7 7M15.5 8.5l-7 7"/></svg>
        </div>
      {%- endif -%}
    </a>

    <!-- Badges -->
    <div class="product-card-badges">
      {%- if on_sale -%}
        {%- assign discount_pct = compare_price | minus: actual_price | times: 100 | divided_by: compare_price -%}
        <span class="badge badge-sale">-{{ discount_pct }}%</span>
      {%- endif -%}
      {%- unless product.available -%}
        <span class="badge badge-sold-out">Sold Out</span>
      {%- endunless -%}
      {%- if product.tags contains 'new' or product.tags contains 'New' -%}
        <span class="badge badge-new">New</span>
      {%- endif -%}
    </div>

    <!-- Quick Add -->
    {%- if product.available -%}
      <button
        class="product-card-quick-add"
        data-product-url="{{ product.url }}"
        onclick="window.location.href='{{ product.url }}'"
        aria-label="View {{ product.title }}"
      >
        View Product
      </button>
    {%- endif -%}
  </div>

  <!-- Content -->
  <div class="product-card-content">
    {%- if product.vendor -%}
      <p class="product-card-vendor">{{ product.vendor }}</p>
    {%- endif -%}

    <a class="product-card-title" href="{{ product.url }}">{{ product.title }}</a>

    <!-- Color Swatches -->
    {%- assign color_option = nil -%}
    {%- for option in product.options_with_values -%}
      {%- assign option_name_lower = option.name | downcase -%}
      {%- if option_name_lower == 'color' or option_name_lower == 'colour' -%}
        {%- assign color_option = option -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if color_option != nil and color_option.values.size > 1 -%}
      <div class="product-card-swatches">
        {%- for color_val in color_option.values limit: 5 -%}
          {%- assign color_lower = color_val | downcase | replace: ' ', '' -%}
          {%- assign variant_with_color = product.variants | where: 'option1', color_val | first -%}
          {%- assign variant_img_src = '' -%}
          {%- if variant_with_color.featured_image -%}
            {%- assign variant_img_src = variant_with_color.featured_image | image_url: width: 540 -%}
          {%- endif -%}
          <span
            class="color-swatch {% if forloop.first %}is-active{% endif %}"
            style="background-color: {{ color_lower }};"
            data-img="{{ variant_img_src }}"
            title="{{ color_val }}"
            role="button"
            tabindex="0"
            aria-label="{{ color_val }}"
          ></span>
        {%- endfor -%}
        {%- if color_option.values.size > 5 -%}
          <span class="color-swatch-more">+{{ color_option.values.size | minus: 5 }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Price -->
    <div class="product-card-price">
      {%- if on_sale -%}
        <span class="price price--sale">{{ actual_price | money }}</span>
        <span class="price price--compare">{{ compare_price | money }}</span>
      {%- else -%}
        <span class="price">{{ actual_price | money }}</span>
      {%- endif -%}
      {%- if settings.bulk_discount_min_qty -%}
        <span class="badge badge-sale" style="font-size:9px;">{{ settings.bulk_discount_percentage }}% bulk off</span>
      {%- endif -%}
    </div>
  </div>
</article>
