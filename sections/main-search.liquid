{% comment %}Section: main-search.liquid — Search results page with predictive search{% endcomment %}

<div class="search-hero">
  <div class="container">
    <h1 class="section-title">
      {%- if search.performed -%}
        {%- if search.results_count == 0 -%}
          No results for "{{ search.terms }}"
        {%- else -%}
          {{ search.results_count }} result{{ search.results_count | plural: '', 's' }} for "{{ search.terms }}"
        {%- endif -%}
      {%- else -%}
        Search
      {%- endif -%}
    </h1>

    <form class="search-form-large" action="/search" method="get" role="search">
      <input type="hidden" name="type" value="product">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search for products..."
        aria-label="Search"
        autocomplete="off"
      >
      <button type="submit" aria-label="Search">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
    </form>
  </div>
</div>

<div class="section">
  <div class="container">
    {%- if search.performed and search.results_count > 0 -%}
      <div class="product-grid product-grid--4">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {%- render 'product-card', product: item -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="pagination-item">‹ Previous</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="pagination-item">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="pagination-item is-current">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="pagination-item">Next ›</a>
          {%- endif -%}
        </nav>
      {%- endif -%}

    {%- elsif search.performed -%}
      <div style="text-align:center;padding:var(--space-16) 0;">
        <p style="font-size:var(--font-size-lg);color:var(--color-muted);margin-bottom:var(--space-6);">
          Try a different search term or browse our collections.
        </p>
        <a href="/collections/all" class="btn btn-primary btn-lg">Browse All Products</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search",
  "settings": [],
  "presets": [{ "name": "Search" }]
}
{% endschema %}
