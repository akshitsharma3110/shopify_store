{% comment %}
  Section: featured-products.liquid
  Reusable product grid: Featured Products & New Arrivals
{% endcomment %}

<section class="section" id="featured-products-{{ section.id }}">
  <div class="container">
    <div class="section-header" style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:16px;">
      <div>
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.collection != blank -%}
        <a href="/collections/{{ section.settings.collection }}" class="btn btn-ghost" style="flex-shrink:0;">
          View all
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      {%- endif -%}
    </div>

    {%- assign coll = collections[section.settings.collection] -%}
    {%- if coll != blank and coll.products_count > 0 -%}
      <div class="product-grid">
        {%- for product in coll.products limit: section.settings.products_count -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <!-- Fallback: show recent products -->
      <div class="product-grid">
        {%- assign recent = collections.all.products -%}
        {%- for product in recent limit: section.settings.products_count -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "collection",
      "label": "Collection handle (e.g. featured)"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Number of products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "settings": {
        "heading": "Featured Products",
        "products_count": 4
      }
    }
  ]
}
{% endschema %}
