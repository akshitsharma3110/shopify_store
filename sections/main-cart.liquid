{% comment %}Section: main-cart.liquid — Full cart page{% endcomment %}

<div class="section">
  <div class="container">
    <form id="cart-page-form" action="/cart" method="post">

      {%- if cart.item_count == 0 -%}
        <div style="text-align:center;padding:var(--space-20) 0;">
          <svg style="color:var(--color-border);margin:0 auto var(--space-6);" width="80" height="80" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"/></svg>
          <h1 class="cart-page-title">Your cart is empty</h1>
          <p style="color:var(--color-muted);margin-bottom:var(--space-8);">Looks like you haven't added anything yet.</p>
          <a href="/collections/all" class="btn btn-accent btn-lg">Shop Now</a>
        </div>
      {%- else -%}
        <h1 class="cart-page-title">
          Your Cart
          {%- if cart.item_count == 1 -%}
            (1 item)
          {%- else -%}
            ({{ cart.item_count }} items)
          {%- endif -%}
        </h1>

        {%- if settings.show_bulk_discount -%}
          {%- assign bulk_min = settings.bulk_discount_min_qty | default: 5 -%}
          {%- assign bulk_pct = settings.bulk_discount_percentage | default: 50 -%}
          <div class="product-bulk-notice" style="margin-bottom:var(--space-6);">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:var(--color-accent);flex-shrink:0;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>
              {%- if cart.item_count >= bulk_min -%}
                🎉 <strong>{{ bulk_pct }}% bulk discount</strong> will be applied at checkout!
              {%- else -%}
                Add {{ bulk_min | minus: cart.item_count }} more piece(s) to unlock <strong>{{ bulk_pct }}% off</strong>!
              {%- endif -%}
            </span>
          </div>
        {%- endif -%}

        <div class="cart-page-layout">

          <!-- Cart Items -->
          <div>
            <div class="cart-page-items">
              {%- for item in cart.items -%}
                <div class="cart-page-item">
                  <a href="{{ item.url }}">
                    <img
                      class="cart-page-item-img"
                      src="{{ item.image | image_url: width: 200 }}"
                      alt="{{ item.product_title | escape }}"
                      loading="lazy"
                    >
                  </a>
                  <div>
                    <a href="{{ item.url }}" style="font-weight:600;font-family:var(--font-heading);font-size:var(--font-size-base);text-decoration:none;color:var(--color-primary);">{{ item.product_title }}</a>
                    {%- if item.variant_title != 'Default Title' -%}
                      <p style="font-size:var(--font-size-sm);color:var(--color-muted);margin-top:4px;">{{ item.variant_title }}</p>
                    {%- endif -%}
                    <p style="font-size:var(--font-size-sm);color:var(--color-muted);margin-top:4px;">{{ item.price | money }} each</p>

                    <div class="qty-selector" style="margin-top:var(--space-4);width:fit-content;">
                      <button type="button" class="qty-btn" data-qty-dec aria-label="Decrease">−</button>
                      <input
                        class="qty-input"
                        type="number"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        min="0"
                        data-cart-line-key="{{ item.key }}"
                        aria-label="Quantity for {{ item.product_title }}"
                      >
                      <button type="button" class="qty-btn" data-qty-inc aria-label="Increase">+</button>
                    </div>

                    <a href="{{ item.url_to_remove }}" class="cart-item-remove" style="display:inline-block;margin-top:var(--space-3);">Remove</a>
                  </div>
                  <div style="text-align:right;">
                    <p style="font-weight:700;font-size:var(--font-size-base);">{{ item.final_line_price | money }}</p>
                    {%- if item.original_line_price != item.final_line_price -%}
                      <p style="text-decoration:line-through;font-size:var(--font-size-sm);color:var(--color-muted);">{{ item.original_line_price | money }}</p>
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>

            {%- if settings.show_order_note -%}
              <div style="margin-top:var(--space-6);">
                <label class="form-label" for="cart-note">Order Notes (customization, colors, logo details)</label>
                <textarea id="cart-note" class="form-textarea" name="note" rows="4" placeholder="{{ 'cart.order_note_placeholder' | t }}">{{ cart.note }}</textarea>
              </div>
            {%- endif -%}
          </div>

          <!-- Order Summary -->
          <div class="cart-summary">
            <h2 class="cart-summary-title">Order Summary</h2>

            <div class="cart-summary-row">
              <span>Subtotal</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <div class="cart-summary-row">
              <span>Shipping</span>
              <span style="color:var(--color-muted);">Calculated at checkout</span>
            </div>
            {%- if cart.total_discount > 0 -%}
              <div class="cart-summary-row" style="color:#16A34A;">
                <span>Discount</span>
                <span>-{{ cart.total_discount | money }}</span>
              </div>
            {%- endif -%}
            <div class="cart-summary-row cart-summary-row--total">
              <span>Estimated Total</span>
              <span>{{ cart.total_price | money }}</span>
            </div>

            <p style="font-size:var(--font-size-xs);color:var(--color-muted);text-align:center;margin-bottom:var(--space-4);">
              {{ 'cart.taxes_note' | t }}
            </p>

            <a href="/checkout" class="btn btn-accent btn-full btn-lg">
              Proceed to Checkout
            </a>
            <a href="/collections/all" class="btn btn-secondary btn-full" style="margin-top:var(--space-3);">
              Continue Shopping
            </a>

            <div style="margin-top:var(--space-4);padding-top:var(--space-4);border-top:1px solid var(--color-border);text-align:center;">
              <p style="font-size:var(--font-size-xs);color:var(--color-muted);">Need custom order?</p>
              <a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" class="btn btn-whatsapp btn-full" style="margin-top:var(--space-2);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                Chat on WhatsApp
              </a>
            </div>
          </div>

        </div>
      {%- endif -%}

    </form>
  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "settings": [],
  "presets": [{ "name": "Cart" }]
}
{% endschema %}
