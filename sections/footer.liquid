            {%- else -%}
              <a href="#" class="ft-social-icon" aria-label="Instagram">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
            {%- endif -%}

            <span class="ft-indiamart">INDIAMART</span>
          </div>
        </div>

        <!-- Col 2 · Explore -->
        <div class="ft-col">
          <h3 class="ft-heading">Explore</h3>
          <nav>
            <a href="/collections/all" class="ft-link">Catalogue</a>
            <a href="/pages/about-us" class="ft-link">About Us</a>
            <a href="/pages/contact" class="ft-link">Contact</a>
            <a href="/cart" class="ft-link">My Cart</a>
          </nav>
        </div>

        <!-- Col 3 · Products -->
        <div class="ft-col">
          <h3 class="ft-heading">Products</h3>
          <nav>
            <a href="/collections/collar-t-shirts" class="ft-link">Collar T-Shirts</a>
            <a href="/collections/round-neck-t-shirts" class="ft-link">Round Neck T-Shirts</a>
            <a href="/collections/shorts" class="ft-link">Shorts</a>
            <a href="/collections/lowers" class="ft-link">Lowers</a>
            <a href="/collections/tracksuits" class="ft-link">Tracksuits</a>
            <a href="/collections/track-jackets" class="ft-link">Track Jackets</a>
          </nav>
        </div>

        <!-- Col 4 · Get in touch -->
        <div class="ft-col">
          <h3 class="ft-heading">Get in touch</h3>
          <address class="ft-address">41/31A Mokhampur, Plot No. 36, Sports Complex Enclave, Delhi Road, Meerut, Uttar Pradesh 250002, India</address>
          <a href="tel:+919997100375" class="ft-contact">+91 99971 00375</a>
          <a href="tel:+918006277622" class="ft-contact">+91 80062 77622</a>
          <a href="mailto:activesportswears@gmail.com" class="ft-contact">activesportswears@gmail.com</a>
          <a href="/collections/all" class="ft-shop-btn">Shop now &nbsp;→</a>
        </div>

      </div>
    </div>
  </div>

  <!-- ── TRUST STRIP ── -->
  <div class="ft-trust">
    <div class="ft-container">
      <div class="ft-trust-row">
        <div class="ft-trust-item">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Verified manufacturer
        </div>
        <div class="ft-trust-item">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
          Made in India
        </div>
        <div class="ft-trust-item">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>
          Factory direct
        </div>
        <div class="ft-trust-item">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
          20+ years in trade
        </div>
      </div>
    </div>
  </div>

  <!-- ── BOTTOM BAR ── -->
  <div class="ft-bottom">
    <div class="ft-container">
      <div class="ft-bottom-row">
        <span>© {{ 'now' | date: '%Y' }} ACCTIVE Sports Industries. All rights reserved.</span>
        <span>Designed and manufactured in Meerut, Uttar Pradesh</span>
      </div>
    </div>
  </div>

</footer>

<!-- Scroll to top -->
<button class="ft-scroll-top" id="ft-scroll-top" aria-label="Back to top" onclick="window.scrollTo({top:0,behavior:'smooth'})">
  <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg>
</button>

<style>
/* ===== FOOTER SELF-CONTAINED STYLES ===== */
.ft {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
}
.ft-container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 1.5rem;
  box-sizing: border-box;
}
.ft * { box-sizing: border-box; }

/* ── Main section ── */
.ft-main {
  background: #0D1526;
  padding: 3.5rem 0 3rem;
}
.ft-grid {
  display: grid;
  grid-template-columns: 1.6fr 1fr 1.2fr 1.6fr;
  gap: 1.5rem 3rem;
}
@media (max-width: 960px) { .ft-grid { grid-template-columns: 1fr 1fr; gap: 2rem; } }
@media (max-width: 560px) { .ft-grid { grid-template-columns: 1fr; } .ft-main { padding: 2.5rem 0 2rem; } }

/* Brand col */
.ft-logo-link { display: inline-block; margin-bottom: 1rem; text-decoration: none; }
.ft-logo-img  { height: 50px; width: auto; display: block; filter: brightness(0) invert(1); }
.ft-logo-text { display: block; }

.ft-tagline {
  font-size: 0.8rem;
  line-height: 1.7;
  color: rgba(255,255,255,0.48);
  margin-bottom: 1.375rem;
  max-width: 30ch;
}

/* Socials */
.ft-socials { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
.ft-social-icon {
  width: 36px; height: 36px;
  border: 1.5px solid rgba(255,255,255,0.18);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: rgba(255,255,255,0.65);
  text-decoration: none;
  transition: all 0.2s;
  flex-shrink: 0;
}
.ft-social-icon:hover { background: #FF6B1A; border-color: #FF6B1A; color: #fff; }
.ft-indiamart {
  padding: 0.3rem 0.875rem;
  border: 1.5px solid rgba(255,255,255,0.22);
  border-radius: 9999px;
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: rgba(255,255,255,0.6);
  white-space: nowrap;
  cursor: default;
}

/* Column headings */
.ft-heading {
  font-size: 0.875rem;
  font-weight: 600;
  color: #fff;
  margin-bottom: 1.125rem;
  font-family: 'Inter', sans-serif;
}

/* Nav links — cyan exactly like reference */
.ft-link {
  display: block;
  font-size: 0.8125rem;
  color: #4FC3F7;
  text-decoration: none;
  padding: 0.28rem 0;
  line-height: 1.5;
  transition: color 0.15s, padding-left 0.15s;
}
.ft-link:hover { color: #fff; padding-left: 0.3rem; }

/* Contact col */
.ft-address {
  font-style: normal;
  font-size: 0.8rem;
  line-height: 1.7;
  color: rgba(255,255,255,0.5);
  margin-bottom: 0.875rem;
}
.ft-contact {
  display: block;
  font-size: 0.8125rem;
  color: rgba(255,255,255,0.65);
  text-decoration: none;
  margin-bottom: 0.35rem;
  transition: color 0.15s;
}
.ft-contact:hover { color: #4FC3F7; }

.ft-shop-btn {
  display: inline-block;
  margin-top: 1.125rem;
  padding: 0.6rem 1.375rem;
  border: 1.5px solid #FF6B1A;
  border-radius: 6px;
  font-size: 0.8125rem;
  font-weight: 600;
  color: #FF6B1A;
  text-decoration: none;
  transition: background 0.2s, color 0.2s;
}
.ft-shop-btn:hover { background: #FF6B1A; color: #fff; }

/* ── Trust strip ── */
.ft-trust {
  background: #0A1020;
  border-top: 1px solid rgba(255,255,255,0.07);
  border-bottom: 1px solid rgba(255,255,255,0.07);
  padding: 0.875rem 0;
}
.ft-trust-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2.5rem;
  flex-wrap: wrap;
}
.ft-trust-item {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  font-size: 0.75rem;
  font-weight: 500;
  color: rgba(255,255,255,0.45);
  white-space: nowrap;
  font-family: 'Inter', sans-serif;
}
.ft-trust-item svg { opacity: 0.5; }
@media (max-width: 560px) { .ft-trust-row { gap: 1rem; } .ft-trust-item { font-size: 0.7rem; } }

/* ── Bottom bar ── */
.ft-bottom {
  background: #060D1A;
  padding: 0.875rem 0;
}
.ft-bottom-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  font-size: 0.75rem;
  color: rgba(255,255,255,0.3);
  font-family: 'Inter', sans-serif;
  flex-wrap: wrap;
}
@media (max-width: 560px) { .ft-bottom-row { flex-direction: column; text-align: center; } }

/* ── Scroll to top ── */
.ft-scroll-top {
  position: fixed;
  bottom: 5.5rem;
  right: 1.25rem;
  z-index: 300;
  width: 42px; height: 42px;
  background: #1A2540;
  border: 1.5px solid rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: rgba(255,255,255,0.7);
  cursor: pointer;
  opacity: 0; pointer-events: none;
  transition: opacity 0.3s, background 0.2s, transform 0.2s;
  box-shadow: 0 4px 16px rgba(0,0,0,0.3);
}
.ft-scroll-top.visible { opacity: 1; pointer-events: auto; }
.ft-scroll-top:hover { background: #FF6B1A; border-color: #FF6B1A; color: #fff; transform: translateY(-2px); }
</style>

<script>
(function(){
  var btn = document.getElementById('ft-scroll-top');
  if (!btn) return;
  window.addEventListener('scroll', function(){
    btn.classList.toggle('visible', window.scrollY > 300);
  }, { passive: true });
})();
</script>

