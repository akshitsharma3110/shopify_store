{% comment %}Section: footer.liquid — Valor-inspired, high-contrast, premium design{% endcomment %}

<footer class="site-footer" id="site-footer" role="contentinfo">

  <!-- ═══ MAIN FOOTER COLUMNS ═══ -->
  <div class="footer-upper">
    <div class="container">
      <div class="footer-grid">

        <!-- Col 1 — Brand -->
        <div class="footer-col footer-col--brand">
          <a href="/" class="footer-logo-link" aria-label="{{ shop.name }}">
            {%- if settings.logo != blank -%}
              <img
                src="{{ settings.logo | image_url: width: 200 }}"
                alt="{{ shop.name }}"
                class="footer-logo-img"
                width="160"
                loading="lazy"
              >
            {%- else -%}
              <span class="footer-wordmark"><span class="footer-wordmark-accent">ACCTIVE</span> Sports</span>
            {%- endif -%}
          </a>

          <p class="footer-tagline">
            {{ section.settings.tagline | default: 'Premium Custom Sportswear, Manufactured in Meerut. Vibrant sublimation, premium fabrics, custom designs and bulk orders with pan-India delivery.' }}
          </p>

          <div class="footer-socials">
            {%- if settings.whatsapp_number != blank -%}
              <a href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}" class="footer-social-btn" target="_blank" rel="noopener" aria-label="WhatsApp">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </a>
            {%- endif -%}

            {%- if settings.social_instagram != blank -%}
              <a href="{{ settings.social_instagram }}" class="footer-social-btn" target="_blank" rel="noopener" aria-label="Instagram">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
            {%- endif -%}

            {%- if settings.social_facebook != blank -%}
              <a href="{{ settings.social_facebook }}" class="footer-social-btn" target="_blank" rel="noopener" aria-label="Facebook">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
              </a>
            {%- endif -%}

            {%- if section.settings.indiamart_url != blank -%}
              <a href="{{ section.settings.indiamart_url }}" class="footer-indiamart" target="_blank" rel="noopener">INDIAMART</a>
            {%- else -%}
              <span class="footer-indiamart">INDIAMART</span>
            {%- endif -%}
          </div>
        </div>

        <!-- Col 2 — Explore -->
        <div class="footer-col">
          <h3 class="footer-col-title">{{ section.settings.col2_heading | default: 'Explore' }}</h3>
          <nav aria-label="Footer explore links">
            {%- for link in linklists[section.settings.footer_menu_1].links -%}
              <a href="{{ link.url }}" class="footer-link">{{ link.title }}</a>
            {%- else -%}
              <a href="/collections/all" class="footer-link">Catalogue</a>
              <a href="/pages/about-us" class="footer-link">About Us</a>
              <a href="/pages/contact" class="footer-link">Contact</a>
              <a href="/cart" class="footer-link">My Cart</a>
            {%- endfor -%}
          </nav>
        </div>

        <!-- Col 3 — Products -->
        <div class="footer-col">
          <h3 class="footer-col-title">{{ section.settings.col3_heading | default: 'Products' }}</h3>
          <nav aria-label="Footer product links">
            {%- for link in linklists[section.settings.footer_menu_2].links -%}
              <a href="{{ link.url }}" class="footer-link">{{ link.title }}</a>
            {%- else -%}
              <a href="/collections/collar-t-shirts" class="footer-link">Collar T-Shirts</a>
              <a href="/collections/round-neck-t-shirts" class="footer-link">Round Neck T-Shirts</a>
              <a href="/collections/shorts" class="footer-link">Shorts</a>
              <a href="/collections/lowers" class="footer-link">Lowers</a>
              <a href="/collections/tracksuits" class="footer-link">Tracksuits</a>
              <a href="/collections/track-jackets" class="footer-link">Track Jackets</a>
            {%- endfor -%}
          </nav>
        </div>

        <!-- Col 4 — Get in touch -->
        <div class="footer-col">
          <h3 class="footer-col-title">{{ section.settings.col4_heading | default: 'Get in touch' }}</h3>

          <address class="footer-address">
            {%- if section.settings.address != blank -%}
              {{ section.settings.address }}
            {%- else -%}
              41/31A Mokhampur, Plot No. 36, Sports Complex Enclave, Delhi Road, Meerut, Uttar Pradesh 250002, India
            {%- endif -%}
          </address>

          <div class="footer-contact-list">
            <a href="tel:+919997100375" class="footer-contact-link">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.0 1.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.16 6.16l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
              {{ settings.contact_phone_display | default: '+91 99971 00375' }}
            </a>
            {%- if section.settings.phone2 != blank -%}
              <a href="tel:{{ section.settings.phone2 | remove: ' ' | remove: '-' }}" class="footer-contact-link">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.0 1.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.16 6.16l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
                {{ section.settings.phone2 }}
              </a>
            {%- else -%}
              <a href="tel:+918006277622" class="footer-contact-link">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.0 1.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.16 6.16l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
                +91 80062 77622
              </a>
            {%- endif -%}
            <a href="mailto:{{ settings.contact_email | default: 'activesportswears@gmail.com' }}" class="footer-contact-link">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              {{ settings.contact_email | default: 'activesportswears@gmail.com' }}
            </a>
          </div>

          <a href="/collections/all" class="footer-shop-now-btn">
            Shop now
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>

      </div>
    </div>
  </div>

  <!-- ═══ TRUST STRIP ═══ -->
  <div class="footer-trust">
    <div class="container">
      <div class="footer-trust-row">
        <div class="footer-trust-item">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Verified manufacturer
        </div>
        <div class="footer-trust-sep" aria-hidden="true"></div>
        <div class="footer-trust-item">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
          Made in India
        </div>
        <div class="footer-trust-sep" aria-hidden="true"></div>
        <div class="footer-trust-item">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>
          Factory direct
        </div>
        <div class="footer-trust-sep" aria-hidden="true"></div>
        <div class="footer-trust-item">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
          20+ years in trade
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ BOTTOM BAR ═══ -->
  <div class="footer-bottom">
    <div class="container">
      <div class="footer-bottom-row">
        <p class="footer-copy">© {{ 'now' | date: '%Y' }} ACCTIVE Sports Industries. All rights reserved.</p>
        <p class="footer-made">Designed &amp; manufactured in Meerut, Uttar Pradesh</p>
      </div>
    </div>
  </div>

</footer>

<!-- ═══ SCROLL TO TOP ═══ -->
<button class="back-to-top" id="back-to-top" aria-label="Back to top" onclick="window.scrollTo({top:0,behavior:'smooth'})">
  <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg>
</button>

<style>
/* ===================================================
   FOOTER — Valor-inspired, premium high-contrast
   =================================================== */

/* ── Variables ── */
.site-footer {
  --f-bg:        #F5F5F5;
  --f-border:    #E2E2E2;
  --f-text:      #1A1A1A;
  --f-muted:     #555555;
  --f-link:      #1A1A1A;
  --f-link-hov:  var(--color-accent, #FF6B1A);
  --f-accent:    var(--color-accent, #FF6B1A);
  --f-trust-bg:  #EBEBEB;
  --f-bottom-bg: #1A1A1A;
  --f-bottom-txt:#9CA3AF;
}

/* ── Reset wrapper ── */
.site-footer * { box-sizing: border-box; }

/* ── Upper ── */
.footer-upper {
  background: var(--f-bg);
  border-top: 1px solid var(--f-border);
  padding: 4rem 0 3rem;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1.15fr 1.5fr;
  gap: 1.5rem 3.5rem;
}
@media (max-width: 980px)  { .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; } }
@media (max-width: 560px)  { .footer-grid { grid-template-columns: 1fr; gap: 2rem; } .footer-upper { padding: 2.5rem 0 2rem; } }

/* Brand col */
.footer-logo-link { display: inline-block; margin-bottom: 1.125rem; }
.footer-logo-img  { height: 48px; width: auto; display: block; }
.footer-wordmark  { font-family: 'Playfair Display', Georgia, serif; font-size: 1.4rem; font-weight: 800; color: var(--f-text); letter-spacing: -0.03em; }
.footer-wordmark-accent { color: var(--f-accent); }

.footer-tagline {
  font-size: 0.825rem;
  line-height: 1.7;
  color: var(--f-muted);
  margin-bottom: 1.5rem;
  max-width: 32ch;
}

/* Socials */
.footer-socials { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }

.footer-social-btn {
  width: 36px; height: 36px;
  border-radius: 50%;
  border: 1.5px solid #D1D5DB;
  display: inline-flex; align-items: center; justify-content: center;
  color: var(--f-muted);
  text-decoration: none;
  transition: border-color .2s, background .2s, color .2s;
  flex-shrink: 0;
}
.footer-social-btn:hover { border-color: var(--f-accent); background: var(--f-accent); color: #fff; }

.footer-indiamart {
  padding: .3rem .875rem;
  border: 1.5px solid #D1D5DB;
  border-radius: 9999px;
  font-size: .625rem;
  font-weight: 700;
  letter-spacing: .08em;
  color: var(--f-muted);
  text-decoration: none;
  transition: border-color .2s, color .2s;
  white-space: nowrap;
}
a.footer-indiamart:hover { border-color: var(--f-accent); color: var(--f-accent); }

/* Column headings */
.footer-col-title {
  font-size: .9375rem;
  font-weight: 700;
  color: var(--f-text);
  letter-spacing: 0;
  margin-bottom: 1.125rem;
  text-transform: none;
}

/* Nav links */
.footer-link {
  display: block;
  font-size: .8125rem;
  color: var(--f-muted);
  text-decoration: none;
  padding: .3rem 0;
  line-height: 1.5;
  border-bottom: none;
  transition: color .15s, padding-left .15s;
}
.footer-link:hover { color: var(--f-link-hov); padding-left: .25rem; }

/* Contact */
.footer-address {
  font-style: normal;
  font-size: .8125rem;
  line-height: 1.7;
  color: var(--f-muted);
  margin-bottom: 1rem;
}

.footer-contact-list { display: flex; flex-direction: column; gap: .375rem; margin-bottom: 1.25rem; }
.footer-contact-link {
  display: inline-flex; align-items: center; gap: .4375rem;
  font-size: .8125rem;
  color: var(--f-muted);
  text-decoration: none;
  transition: color .15s;
}
.footer-contact-link:hover { color: var(--f-link-hov); }
.footer-contact-link svg { flex-shrink: 0; opacity: .65; }

/* Shop now btn — accent outlined pill */
.footer-shop-now-btn {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  padding: .55rem 1.25rem;
  border: 1.5px solid var(--f-accent);
  border-radius: 9999px;
  font-size: .8125rem;
  font-weight: 600;
  color: var(--f-accent);
  text-decoration: none;
  transition: background .2s, color .2s;
}
.footer-shop-now-btn:hover { background: var(--f-accent); color: #fff; }

/* ── Trust strip ── */
.footer-trust {
  background: var(--f-trust-bg);
  border-top: 1px solid var(--f-border);
  border-bottom: 1px solid var(--f-border);
  padding: .9rem 0;
}
.footer-trust-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  flex-wrap: wrap;
}
.footer-trust-item {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  font-size: .75rem;
  font-weight: 600;
  color: #444;
  letter-spacing: .01em;
  white-space: nowrap;
}
.footer-trust-item svg { opacity: .65; flex-shrink: 0; }
.footer-trust-sep {
  width: 1px;
  height: 16px;
  background: #C8C8C8;
  flex-shrink: 0;
}
@media (max-width: 540px) { .footer-trust-sep { display: none; } .footer-trust-row { gap: .625rem 1rem; } }

/* ── Bottom bar ── */
.footer-bottom {
  background: var(--f-bottom-bg);
  padding: 1rem 0;
}
.footer-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}
.footer-copy,
.footer-made {
  font-size: .75rem;
  color: var(--f-bottom-txt);
  margin: 0;
  line-height: 1.5;
}
@media (max-width: 580px) { .footer-bottom-row { flex-direction: column; text-align: center; } }

/* ── Back to top ── */
.back-to-top {
  position: fixed;
  bottom: 1.5rem;
  right: 1.5rem;
  z-index: 250;
  width: 44px; height: 44px;
  border-radius: 50%;
  background: #fff;
  border: 1.5px solid #D1D5DB;
  display: flex; align-items: center; justify-content: center;
  color: #555;
  cursor: pointer;
  opacity: 0;
  pointer-events: none;
  transition: opacity .3s, background .2s, border-color .2s, transform .2s;
  box-shadow: 0 2px 12px rgba(0,0,0,.1);
}
.back-to-top.visible { opacity: 1; pointer-events: auto; }
.back-to-top:hover { background: var(--color-accent, #FF6B1A); border-color: var(--color-accent, #FF6B1A); color: #fff; transform: translateY(-2px); }
</style>

<script>
(function(){
  var btn = document.getElementById('back-to-top');
  if (!btn) return;
  window.addEventListener('scroll', function(){
    btn.classList.toggle('visible', window.scrollY > 350);
  }, { passive: true });
})();
</script>

{% schema %}
{
  "name": "Footer",
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
