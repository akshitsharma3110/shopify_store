{% comment %}Section: footer.liquid — matches reference design exactly{% endcomment %}

<footer class="site-footer" id="site-footer" role="contentinfo">

  <!-- ── Main grid ── -->
  <div class="footer-main">
    <div class="container">
      <div class="footer-grid">

        <!-- Col 1 : Brand -->
        <div class="footer-col footer-col--brand">
          <a href="/" class="footer-logo-link" aria-label="{{ shop.name }}">
            {%- if settings.logo != blank -%}
              <img
                src="{{ settings.logo | image_url: width: 220 }}"
                alt="{{ shop.name }}"
                class="footer-logo-img"
                width="160"
                loading="lazy"
              >
            {%- else -%}
              <div class="footer-logo-text-wrap">
                <svg width="120" height="40" viewBox="0 0 120 40" fill="none" aria-label="{{ shop.name }}">
                  <text x="0" y="30" font-family="'Playfair Display',serif" font-weight="800" font-size="28" fill="white" letter-spacing="-1">ACCTIVE</text>
                </svg>
              </div>
            {%- endif -%}
          </a>

          <p class="footer-tagline">
            {{ section.settings.tagline | default: 'Premium Custom Sportswear, Manufactured in Meerut. Vibrant sublimation, premium fabrics, custom designs and bulk orders with pan-India delivery.' }}
          </p>

          <div class="footer-socials">
            {%- if settings.whatsapp_number != blank -%}
              <a
                href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}"
                class="footer-social-icon"
                target="_blank" rel="noopener noreferrer"
                aria-label="WhatsApp"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
              </a>
            {%- endif -%}

            {%- if settings.social_instagram != blank -%}
              <a
                href="{{ settings.social_instagram }}"
                class="footer-social-icon"
                target="_blank" rel="noopener noreferrer"
                aria-label="Instagram"
              >
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
            {%- endif -%}

            {%- if section.settings.indiamart_url != blank -%}
              <a
                href="{{ section.settings.indiamart_url }}"
                class="footer-indiamart-badge"
                target="_blank" rel="noopener noreferrer"
                aria-label="IndiaMart"
              >INDIAMART</a>
            {%- endif -%}
          </div>
        </div>

        <!-- Col 2 : Explore -->
        <div class="footer-col">
          <h3 class="footer-col-heading">{{ section.settings.col2_heading | default: 'Explore' }}</h3>
          <nav>
            {%- for link in linklists[section.settings.footer_menu_1].links -%}
              <a href="{{ link.url }}" class="footer-nav-link">{{ link.title }}</a>
            {%- endfor -%}
          </nav>
        </div>

        <!-- Col 3 : Products -->
        <div class="footer-col">
          <h3 class="footer-col-heading">{{ section.settings.col3_heading | default: 'Products' }}</h3>
          <nav>
            {%- for link in linklists[section.settings.footer_menu_2].links -%}
              <a href="{{ link.url }}" class="footer-nav-link">{{ link.title }}</a>
            {%- endfor -%}
          </nav>
        </div>

        <!-- Col 4 : Get in touch -->
        <div class="footer-col">
          <h3 class="footer-col-heading">{{ section.settings.col4_heading | default: 'Get in touch' }}</h3>

          {%- if section.settings.address != blank -%}
            <address class="footer-address">{{ section.settings.address }}</address>
          {%- else -%}
            <address class="footer-address">41/31A Mokhampur, Plot No. 36, Sports Complex Enclave, Delhi Road, Meerut, Uttar Pradesh 250002, India</address>
          {%- endif -%}

          {%- if settings.whatsapp_number != blank -%}
            <a href="tel:{{ settings.whatsapp_number | remove: ' ' }}" class="footer-contact-item">
              {{ settings.contact_phone_display | default: '+91 99971 00375' }}
            </a>
          {%- endif -%}

          {%- if section.settings.phone2 != blank -%}
            <a href="tel:{{ section.settings.phone2 | remove: ' ' }}" class="footer-contact-item">
              {{ section.settings.phone2 }}
            </a>
          {%- else -%}
            <a href="tel:+918006277622" class="footer-contact-item">+91 80062 77622</a>
          {%- endif -%}

          {%- if settings.contact_email != blank -%}
            <a href="mailto:{{ settings.contact_email }}" class="footer-contact-item">{{ settings.contact_email }}</a>
          {%- else -%}
            <a href="mailto:activesportswears@gmail.com" class="footer-contact-item">activesportswears@gmail.com</a>
          {%- endif -%}

          <a href="/collections/all" class="footer-shop-btn">
            Shop now
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>

      </div><!-- /footer-grid -->
    </div><!-- /container -->
  </div><!-- /footer-main -->

  <!-- ── Trust strip ── -->
  <div class="footer-trust-strip">
    <div class="container">
      <div class="footer-trust-items">

        <div class="footer-trust-item">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Verified manufacturer</span>
        </div>

        <div class="footer-trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span>Made in India</span>
        </div>

        <div class="footer-trust-item">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          <span>Factory direct</span>
        </div>

        <div class="footer-trust-item">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span>20+ years in trade</span>
        </div>

      </div>
    </div>
  </div>

  <!-- ── Bottom bar ── -->
  <div class="footer-bottom-bar">
    <div class="container">
      <div class="footer-bottom-inner">
        <span>© {{ 'now' | date: '%Y' }} ACCTIVE Sports Industries. All rights reserved.</span>
        <span>Designed and manufactured in Meerut, Uttar Pradesh</span>
      </div>
    </div>
  </div>

  <!-- ── Scroll to top ── -->
  <button
    class="scroll-to-top"
    id="scroll-to-top"
    aria-label="Scroll to top"
    onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
  >
    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg>
  </button>

</footer>

<style>
/* ============ FOOTER — Reference Design ============ */
.site-footer {
  background: #0B1120;
  color: rgba(255,255,255,0.75);
}

/* Main grid */
.footer-main {
  padding: 3.5rem 0 2.5rem;
}
.footer-grid {
  display: grid;
  grid-template-columns: 1.6fr 1fr 1.2fr 1.6fr;
  gap: 2rem 3rem;
}
@media (max-width: 960px) {
  .footer-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 560px) {
  .footer-grid { grid-template-columns: 1fr; }
  .footer-main { padding: 2.5rem 0 2rem; }
}

/* Brand col */
.footer-logo-link { display: inline-block; margin-bottom: 1rem; }
.footer-logo-img { height: 52px; width: auto; filter: brightness(0) invert(1); }
.footer-tagline {
  font-size: 0.8125rem;
  line-height: 1.65;
  color: rgba(255,255,255,0.5);
  margin-bottom: 1.25rem;
  max-width: 30ch;
}

/* Socials */
.footer-socials { display: flex; align-items: center; gap: 0.625rem; flex-wrap: wrap; }
.footer-social-icon {
  width: 36px; height: 36px;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.2);
  display: flex; align-items: center; justify-content: center;
  color: rgba(255,255,255,0.7);
  text-decoration: none;
  transition: background 0.2s, border-color 0.2s, color 0.2s;
  flex-shrink: 0;
}
.footer-social-icon:hover {
  background: var(--color-accent, #FF6B1A);
  border-color: var(--color-accent, #FF6B1A);
  color: #fff;
}
.footer-indiamart-badge {
  padding: 0.3rem 0.875rem;
  border: 1px solid rgba(255,255,255,0.25);
  border-radius: 9999px;
  font-size: 0.625rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: rgba(255,255,255,0.65);
  text-decoration: none;
  transition: border-color 0.2s, color 0.2s;
  white-space: nowrap;
}
.footer-indiamart-badge:hover { border-color: #fff; color: #fff; }

/* Column headings */
.footer-col-heading {
  font-size: 0.875rem;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.01em;
  margin-bottom: 1.125rem;
}

/* Nav links */
.footer-nav-link {
  display: block;
  font-size: 0.8125rem;
  color: #38BDF8;
  text-decoration: none;
  padding: 0.3rem 0;
  line-height: 1.4;
  transition: color 0.15s, padding-left 0.15s;
}
.footer-nav-link:hover { color: #fff; padding-left: 0.375rem; }

/* Contact col */
.footer-address {
  font-style: normal;
  font-size: 0.8125rem;
  line-height: 1.65;
  color: rgba(255,255,255,0.55);
  margin-bottom: 0.875rem;
}
.footer-contact-item {
  display: block;
  font-size: 0.8125rem;
  color: rgba(255,255,255,0.65);
  text-decoration: none;
  margin-bottom: 0.375rem;
  transition: color 0.15s;
}
.footer-contact-item:hover { color: #38BDF8; }

.footer-shop-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 1.125rem;
  padding: 0.6rem 1.25rem;
  border: 1.5px solid var(--color-accent, #FF6B1A);
  border-radius: 6px;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--color-accent, #FF6B1A);
  text-decoration: none;
  letter-spacing: 0.02em;
  transition: background 0.2s, color 0.2s;
}
.footer-shop-btn:hover {
  background: var(--color-accent, #FF6B1A);
  color: #fff;
}

/* Trust strip */
.footer-trust-strip {
  background: #0D1526;
  border-top: 1px solid rgba(255,255,255,0.07);
  border-bottom: 1px solid rgba(255,255,255,0.07);
  padding: 0.875rem 0;
}
.footer-trust-items {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2.5rem;
  flex-wrap: wrap;
}
.footer-trust-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  font-weight: 500;
  color: rgba(255,255,255,0.55);
  white-space: nowrap;
}
.footer-trust-item svg { color: rgba(255,255,255,0.4); flex-shrink: 0; }
@media (max-width: 560px) {
  .footer-trust-items { gap: 1rem; }
  .footer-trust-item { font-size: 0.7rem; }
}

/* Bottom bar */
.footer-bottom-bar {
  background: #080E1C;
  padding: 0.875rem 0;
}
.footer-bottom-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  font-size: 0.75rem;
  color: rgba(255,255,255,0.35);
  flex-wrap: wrap;
}
@media (max-width: 600px) {
  .footer-bottom-inner { justify-content: center; text-align: center; }
}

/* Scroll to top */
.scroll-to-top {
  position: fixed;
  bottom: 1.5rem;
  right: 1.5rem;
  width: 44px; height: 44px;
  background: #1A2340;
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: rgba(255,255,255,0.7);
  cursor: pointer;
  z-index: 200;
  transition: background 0.2s, transform 0.2s, opacity 0.3s;
  opacity: 0; pointer-events: none;
}
.scroll-to-top.is-visible { opacity: 1; pointer-events: auto; }
.scroll-to-top:hover { background: var(--color-accent, #FF6B1A); color: #fff; transform: translateY(-2px); }
</style>

<script>
(function() {
  var btn = document.getElementById('scroll-to-top');
  if (!btn) return;
  window.addEventListener('scroll', function() {
    btn.classList.toggle('is-visible', window.scrollY > 300);
  }, { passive: true });
})();
</script>

{% schema %}
{
  "name": "Footer",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand tagline",
      "default": "Premium Custom Sportswear, Manufactured in Meerut. Vibrant sublimation, premium fabrics, custom designs and bulk orders with pan-India delivery."
    },
    {
      "type": "url",
      "id": "indiamart_url",
      "label": "IndiaMart profile URL"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "41/31A Mokhampur, Plot No. 36, Sports Complex Enclave, Delhi Road, Meerut, Uttar Pradesh 250002, India"
    },
    {
      "type": "text",
      "id": "phone2",
      "label": "Second phone number",
      "default": "+91 80062 77622"
    },
    {
      "type": "text",
      "id": "col2_heading",
      "label": "Column 2 heading",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "col3_heading",
      "label": "Column 3 heading",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "col4_heading",
      "label": "Column 4 heading",
      "default": "Get in touch"
    },
    {
      "type": "link_list",
      "id": "footer_menu_1",
      "label": "Explore menu",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "footer_menu_2",
      "label": "Products menu",
      "default": "footer-collections"
    }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
