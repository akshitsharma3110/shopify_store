{% comment %}Section: footer.liquid{% endcomment %}

<footer class="ft" id="site-footer" role="contentinfo">

  <!-- ── MAIN COLUMNS ── -->
  <div class="ft-main">
    <div class="ft-container">
      <div class="ft-grid">

        <!-- Col 1 · Brand -->
        <div class="ft-brand">
          <a href="/" class="ft-logo-link" aria-label="{{ shop.name }}">
            {%- if settings.logo != blank -%}
              <img class="ft-logo-img" src="{{ settings.logo | image_url: width: 220 }}" alt="{{ shop.name }}" width="160" loading="lazy">
            {%- else -%}
              <div class="ft-logo-text">
                <svg width="130" height="50" viewBox="0 0 130 50" fill="none">
                  <path d="M8 38 L20 12 L32 38" stroke="white" stroke-width="3" fill="none"/>
                  <path d="M12 30 L28 30" stroke="#FF6B1A" stroke-width="2.5"/>
