{% comment %}Section: main-collection.liquid — AJAX filter/sort with sidebar{% endcomment %}

{%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}

<div class="section section--sm">
  <div class="container">

    <!-- Collection Header -->
    <div class="collection-header">
      <div class="collection-title-group">
        <h1 class="collection-page-title">{{ collection.title }}</h1>
        <p class="collection-count" id="collection-count">{{ collection.products_count }} products</p>
      </div>
      <div class="collection-toolbar">
        <!-- Mobile filter toggle -->
        <button id="filter-mobile-btn" class="filter-mobile-btn" aria-expanded="false" aria-controls="collection-sidebar">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="20" y2="12"/><line x1="12" y1="18" x2="20" y2="18"/></svg>
          Filter
        </button>
        <!-- Sort -->
        <div class="sort-select-wrapper">
          <label for="collection-sort-select" class="visually-hidden">Sort by</label>
          <select id="collection-sort-select" class="sort-select">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </div>
        <!-- View toggle -->
        <div class="view-toggle">
          <button class="view-toggle-btn is-active" data-view="grid" title="Grid view">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M1 2.5A1.5 1.5 0 012.5 1h3A1.5 1.5 0 017 2.5v3A1.5 1.5 0 015.5 7h-3A1.5 1.5 0 011 5.5v-3zm8 0A1.5 1.5 0 0110.5 1h3A1.5 1.5 0 0115 2.5v3A1.5 1.5 0 0113.5 7h-3A1.5 1.5 0 019 5.5v-3zm-8 8A1.5 1.5 0 012.5 9h3A1.5 1.5 0 017 10.5v3A1.5 1.5 0 015.5 15h-3A1.5 1.5 0 011 13.5v-3zm8 0A1.5 1.5 0 0110.5 9h3A1.5 1.5 0 0115 10.5v3A1.5 1.5 0 0113.5 15h-3A1.5 1.5 0 019 13.5v-3z"/></path></svg>
          </button>
          <button class="view-toggle-btn" data-view="list" title="List view">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M2.5 12a.5.5 0 01.5-.5h10a.5.5 0 010 1H3a.5.5 0 01-.5-.5zm0-4a.5.5 0 01.5-.5h10a.5.5 0 010 1H3a.5.5 0 01-.5-.5zm0-4a.5.5 0 01.5-.5h10a.5.5 0 010 1H3a.5.5 0 01-.5-.5z"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Active filter pills -->
    {%- if current_tags.size > 0 or current_filters.size > 0 -%}
      <div class="active-filters" id="active-filters">
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <a href="{{ value.url_to_remove }}" class="active-filter-pill" data-filter-remove data-filter-key="{{ filter.param_name }}" data-filter-value="{{ value.value }}">
              {{ value.label }}
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </a>
          {%- endfor -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
              <a href="{{ filter.url_to_remove }}" class="active-filter-pill" data-filter-remove>
                Price
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        <button id="filter-clear-all" class="active-filter-pill" style="background:transparent;color:var(--color-muted);border:1px solid var(--color-border);">Clear all</button>
      </div>
    {%- endif -%}

    <!-- Layout: Sidebar + Grid -->
    <div class="collection-layout">

      <!-- Sidebar Filters -->
      <aside class="collection-sidebar" id="collection-sidebar">
        <div class="filter-panel">
          <div class="filter-panel-header">
            <span class="filter-panel-title">Filter</span>
            <button id="filter-clear-all" class="filter-clear-all">Clear all</button>
          </div>

          <form id="collection-filter-form" action="{{ collection.url }}">
            {%- if section.settings.show_sort -%}
              <input type="hidden" name="sort_by" value="{{ sort_by }}">
            {%- endif -%}

            {%- for filter in collection.filters -%}
              <div class="filter-group">
                <button type="button" class="filter-group-toggle" aria-expanded="true">
                  {{ filter.label }}
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="filter-group-body">
                  {%- if filter.type == 'boolean' or filter.type == 'list' -%}
                    {%- if filter.label downcase == 'color' or filter.label downcase == 'colour' -%}
                      <div class="filter-color-swatches">
                        {%- for value in filter.values -%}
                          {%- assign color_lower = value.label | downcase | replace: ' ', '' -%}
                          <label title="{{ value.label }} ({{ value.count }})">
                            <input type="checkbox" name="{{ filter.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} style="display:none;">
                            <div class="filter-swatch {% if value.active %}is-active{% endif %}" style="background-color:{{ color_lower }};"></div>
                          </label>
                        {%- endfor -%}
                      </div>
                    {%- else -%}
                      {%- for value in filter.values -%}
                        <label class="filter-option">
                          <input type="checkbox" name="{{ filter.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                          {{ value.label }}
                          <span class="filter-count">{{ value.count }}</span>
                        </label>
                      {%- endfor -%}
                    {%- endif -%}
                  {%- elsif filter.type == 'price_range' -%}
                    <div style="display:flex;gap:8px;align-items:center;">
                      <input class="form-input" type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" placeholder="Min" min="{{ filter.range_min | divided_by: 100 }}" max="{{ filter.range_max | divided_by: 100 }}" style="padding:0.5rem;">
                      <span>–</span>
                      <input class="form-input" type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" placeholder="Max" min="{{ filter.range_min | divided_by: 100 }}" max="{{ filter.range_max | divided_by: 100 }}" style="padding:0.5rem;">
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </form>
        </div>
      </aside>

      <!-- Product Grid -->
      <div>
        {%- if collection.products.size > 0 -%}
          <div id="product-grid-container" class="product-grid product-grid--4">
            {%- for product in collection.products limit: section.settings.products_per_page -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="pagination" aria-label="Pagination">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="pagination-item">‹</a>
              {%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" class="pagination-item">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="pagination-item is-current">{{ part.title }}</span>
                {%- else -%}
                  <span class="pagination-item" style="border:none;pointer-events:none;">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="pagination-item">›</a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- else -%}
          <div style="text-align:center;padding:var(--space-16) 0;color:var(--color-muted);">
            <p style="font-size:var(--font-size-lg);margin-bottom:var(--space-4);">No products found</p>
            <a href="{{ collection.url }}" class="btn btn-secondary">Clear filters</a>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 8, "max": 48, "step": 4, "default": 24, "label": "Products per page" },
    { "type": "checkbox", "id": "show_filter", "default": true, "label": "Show filters" },
    { "type": "checkbox", "id": "show_sort", "default": true, "label": "Show sort" }
  ],
  "presets": [{ "name": "Collection" }]
}
{% endschema %}
