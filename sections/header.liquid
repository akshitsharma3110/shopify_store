{% comment %}Section: header.liquid — Valor-inspired sticky header for ACCTIVE Sports{% endcomment %}

{%- if section.settings.show_announcement -%}
  <div
    class="announcement-bar"
    style="background:{{ section.settings.announcement_bg | default: '#0F0F0F' }};color:{{ section.settings.announcement_text_color | default: '#FFFFFF' }};"
    id="announcement-bar"
    role="complementary"
    aria-label="Announcement"
  >
    <div class="container">
      {{ section.settings.announcement_text | default: '🏭 Factory-Direct Custom Sportswear | MOQ 5 Pieces | Pan-India Delivery | WhatsApp: +91 99971 00375' }}
    </div>
    {%- if section.settings.announcement_dismissible -%}
      <button data-announcement-dismiss aria-label="Dismiss announcement">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    {%- endif -%}
  </div>
{%- endif -%}

<header class="site-header" id="site-header" role="banner" {{ block.shopify_attributes }}>
  <div class="header-inner">

    <!-- Left: Nav links -->
    <nav class="header-nav" role="navigation" aria-label="Main navigation">
      {%- for link in linklists[section.settings.menu].links -%}
        <a
          href="{{ link.url }}"
          class="header-nav-link"
          {% if link.url == request.path %}aria-current="page"{% endif %}
        >{{ link.title }}</a>
      {%- else -%}
        <a href="/" class="header-nav-link">Home</a>
        <a href="/collections/all" class="header-nav-link">Shop</a>
        <a href="/pages/about-us" class="header-nav-link">About</a>
        <a href="/pages/contact" class="header-nav-link">Contact</a>
      {%- endfor -%}
    </nav>

    <!-- Center: Logo -->
    <a href="/" class="header-logo" aria-label="{{ shop.name }} — Home">
      {%- if settings.logo != blank -%}
        <img
          src="{{ settings.logo | image_url: width: 200 }}"
          alt="{{ shop.name }}"
          width="140"
          height="40"
          loading="eager"
        >
      {%- else -%}
        <span class="header-logo-text">
          <span class="accent">ACCTIVE</span> Sports
        </span>
      {%- endif -%}
    </a>

    <!-- Right: Actions -->
    <div class="header-actions">

      <!-- Predictive Search -->
      <div class="predictive-search-wrapper" id="predictive-search-wrapper">
        <form class="predictive-search-form" action="/search" method="get" role="search">
          <input type="hidden" name="type" value="product">
          <button class="predictive-search-btn" type="submit" aria-label="Search">
            <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </button>
          <input
            id="predictive-search-input"
            class="predictive-search-input"
            type="search"
            name="q"
            placeholder="{{ 'general.search.search_placeholder' | t }}"
            aria-label="{{ 'general.search.search' | t }}"
            autocomplete="off"
            spellcheck="false"
          >
        </form>
        <div
          id="predictive-search-results"
          class="predictive-search-results"
          role="listbox"
          aria-label="Search suggestions"
          hidden
        ></div>
      </div>

      <!-- Cart -->
      <button
        class="header-icon-btn"
        id="cart-icon-btn"
        aria-label="{{ 'general.accessibility.open_cart' | t }} ({{ cart.item_count }} items)"
        data-cart-toggle
      >
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        {%- if cart.item_count > 0 -%}
          <span class="cart-count-bubble" id="cart-count" aria-live="polite">{{ cart.item_count }}</span>
        {%- else -%}
          <span class="cart-count-bubble" id="cart-count" aria-live="polite" hidden>0</span>
        {%- endif -%}
      </button>

      <!-- Shop CTA (desktop only) -->
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="btn btn-accent btn-sm header-shop-btn" id="header-cta-btn">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}

      <!-- Hamburger (mobile only) -->
      <button
        class="header-menu-btn"
        id="mobile-menu-btn"
        aria-label="{{ 'general.accessibility.open_menu' | t }}"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "🏭 Factory-Direct Custom Sportswear | MOQ 5 Pieces | Pan-India Delivery | WhatsApp: +91 99971 00375"
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Announcement background",
      "default": "#0F0F0F"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Announcement text color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "announcement_dismissible",
      "label": "Allow dismissing announcement",
      "default": true
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
