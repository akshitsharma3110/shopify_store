{% comment %}Section: header.liquid — Sticky header with inline predictive search{% endcomment %}

<header class="site-header" id="site-header" role="banner">
  <div class="header-inner">

    <!-- Logo -->
    <a href="/" class="header-logo" aria-label="{{ shop.name }}">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 320 }}" alt="{{ shop.name }}" width="{{ settings.logo_width | default: 160 }}" height="40" loading="eager">
      {%- else -%}
        <span class="header-logo-text"><span>ACCTIVE</span> Sports</span>
      {%- endif -%}
    </a>

    <!-- Desktop Navigation -->
    <nav class="header-nav" role="navigation" aria-label="Main menu">
      {%- for link in linklists[section.settings.menu].links -%}
        {%- if link.links != blank -%}
          <div class="nav-dropdown-wrapper" style="position:relative;">
            <button class="header-nav-link" aria-haspopup="true" aria-expanded="false" style="cursor:pointer;background:none;border:none;display:flex;align-items:center;gap:4px;">
              {{ link.title }}
              <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <ul class="nav-dropdown" style="position:absolute;top:calc(100% + 8px);left:0;min-width:200px;background:white;border:1px solid var(--color-border);border-radius:var(--radius-md);box-shadow:var(--shadow-lg);list-style:none;padding:8px 0;z-index:var(--z-dropdown);display:none;animation:slideDown 0.15s ease;">
              {%- for child in link.links -%}
                <li>
                  <a href="{{ child.url }}" class="header-nav-link" style="display:block;padding:8px 16px;border-radius:0;">{{ child.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- else -%}
          <a href="{{ link.url }}" class="header-nav-link" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">

      <!-- Predictive Search -->
      <div class="predictive-search-wrapper">
        <form id="predictive-search-form" class="predictive-search-form" action="/search" method="get" role="search">
          <input type="hidden" name="type" value="product">
          <button type="submit" class="predictive-search-btn" aria-label="Search">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </button>
          <input
            id="predictive-search-input"
            class="predictive-search-input"
            type="search"
            name="q"
            placeholder="{{ 'general.search.search_placeholder' | t }}"
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
            aria-label="{{ 'general.search.search' | t }}"
            aria-expanded="false"
            aria-controls="predictive-search-results"
          >
        </form>
        <div id="predictive-search-results" class="predictive-search-results" role="listbox" hidden></div>
      </div>

      <!-- Cart -->
      <button class="header-icon-btn" data-cart-open aria-label="{{ 'header.cart_label' | t }}" id="cart-btn">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        <span class="cart-count-bubble" data-cart-count style="display:none;">{{ cart.item_count }}</span>
      </button>

      <!-- Custom Order CTA -->
      <a href="{{ settings.custom_order_url | default: '/pages/custom-order' }}" class="btn btn-accent btn-sm header-custom-order" id="custom-order-btn">
        {{ settings.custom_order_label | default: 'Custom Order' }}
      </a>

      <!-- Mobile Menu Toggle -->
      <button class="header-menu-btn" id="header-menu-open" aria-label="{{ 'general.accessibility.open_menu' | t }}" aria-expanded="false" aria-controls="mobile-nav">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>

    </div>
  </div>
</header>

<style>
  .nav-dropdown-wrapper:hover .nav-dropdown,
  .nav-dropdown-wrapper:focus-within .nav-dropdown { display: block !important; }
</style>

{% schema %}
{
  "name": "Header",
  "limit": 1,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    }
  ],
  "presets": [{ "name": "Header" }]
}
{% endschema %}
