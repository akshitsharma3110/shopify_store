{% comment %}
  Section: collection-grid.liquid
  Shop by Category — 8 collection cards
{% endcomment %}

<section class="section" id="shop-by-category">
  <div class="container">
    <div class="section-header">
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="section-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="collection-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll_handle = block.settings.collection
          assign coll = collections[coll_handle]
          assign card_title = block.settings.title | default: coll.title
          assign card_image = block.settings.image | default: coll.image
          assign card_url = block.settings.url | default: coll.url | default: '/collections/' | append: coll_handle
        -%}
        <a
          href="{{ card_url }}"
          class="collection-card"
          {{ block.shopify_attributes }}
          aria-label="{{ card_title }}"
        >
          {%- if card_image != blank -%}
            <img
              class="collection-card-image"
              src="{{ card_image | image_url: width: 600 }}"
              alt="{{ card_title | escape }}"
              width="600"
              height="800"
              loading="lazy"
            >
          {%- else -%}
            <div style="position:absolute;inset:0;background:var(--color-primary);opacity:0.8;"></div>
          {%- endif -%}
          <div class="collection-card-overlay"></div>
          <div class="collection-card-content">
            <h3 class="collection-card-title">{{ card_title }}</h3>
            <span class="collection-card-link">
              Shop now
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_cta -%}
      <div style="text-align:center;margin-top:40px;">
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="btn btn-secondary">
          {{ section.settings.cta_label | default: 'View All Products' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by Category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our complete range of custom sportswear"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show view all button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "View All Products"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL",
      "default": "/collections/all"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "limit": 8,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override (optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override (optional)"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL override (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "blocks": [
        { "type": "category_card", "settings": { "collection": "collar-t-shirts" } },
        { "type": "category_card", "settings": { "collection": "round-neck-t-shirts" } },
        { "type": "category_card", "settings": { "collection": "shorts" } },
        { "type": "category_card", "settings": { "collection": "lowers" } },
        { "type": "category_card", "settings": { "collection": "tracksuits" } },
        { "type": "category_card", "settings": { "collection": "track-jackets" } },
        { "type": "category_card", "settings": { "collection": "featured" } },
        { "type": "category_card", "settings": { "collection": "new-arrivals" } }
      ]
    }
  ]
}
{% endschema %}
