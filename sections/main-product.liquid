{% comment %}
  Section: main-product.liquid
  Full product detail page with gallery, metafields, size selector, bulk discount, tabs, related products
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign price = current_variant.price
  assign compare_price = current_variant.compare_at_price
  assign price_on_request = false
  if price == 0 or price == blank
    assign price_on_request = true
  endif

  assign fabric = product.metafields.custom.fabric.value
  assign sport = product.metafields.custom.sport.value
  assign moq = product.metafields.custom.moq.value
  assign back_image = product.metafields.custom.back_image.value

  assign wa_number = settings.whatsapp_number | default: '919997100375'
  assign wa_msg = 'Hello! I want a custom quote for: ' | append: product.title | append: ' | URL: ' | append: shop.url | append: product.url
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_msg | url_encode
-%}

{%- render 'breadcrumb' -%}

<div class="container" style="padding-top:32px;padding-bottom:64px;" id="product-page">

  <div class="product-layout">

    <!-- Gallery -->
    <div class="product-gallery" id="product-gallery">
      <div class="product-main-image" id="product-main-image">
        {%- if product.featured_image -%}
          <img
            id="product-featured-img"
            src="{{ product.featured_image | image_url: width: 900 }}"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            width="900"
            height="900"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 or back_image != blank -%}
        <div class="product-thumbnails">
          {%- for image in product.images limit: 4 -%}
            <button
              class="product-thumbnail {% if forloop.first %}active{% endif %}"
              onclick="document.getElementById('product-featured-img').src='{{ image | image_url: width: 900 }}'"
              aria-label="View image {{ forloop.index }}"
            >
              <img src="{{ image | image_url: width: 120 }}" alt="{{ image.alt | default: product.title | escape }}" width="120" height="120" loading="lazy">
            </button>
          {%- endfor -%}
          {%- if back_image != blank -%}
            <button
              class="product-thumbnail"
              onclick="document.getElementById('product-featured-img').src='{{ back_image | image_url: width: 900 }}'"
              aria-label="View back"
            >
              <img src="{{ back_image | image_url: width: 120 }}" alt="Back view" width="120" height="120" loading="lazy">
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Product Info -->
    <div class="product-info" id="product-info">

      <!-- Category badge -->
      {%- if product.type != blank -%}
        <div class="product-category-badge">
          <span class="badge badge-muted">{{ product.type }}</span>
        </div>
      {%- endif -%}

      <h1 class="product-title">{{ product.title }}</h1>

      <!-- Price Block -->
      <div class="product-price-block">
        {%- if price_on_request -%}
          <span class="price-on-request" style="font-size:1.5rem;">{{ 'products.price_on_request' | t }}</span>
        {%- else -%}
          <span class="product-price-current" id="product-price-display">{{ price | money }}</span>
          {%- if compare_price > price -%}
            <div>
              <span class="product-price-label">{{ 'products.mrp_label' | t }}</span>
              <span class="product-price-mrp" id="product-mrp-display">{{ compare_price | money }}</span>
            </div>
            {%- assign savings_pct = compare_price | minus: price | times: 100 | divided_by: compare_price | round -%}
            <span class="badge badge-accent">{{ savings_pct }}% off</span>
          {%- endif -%}
        {%- endif -%}
      </div>

      <!-- Bulk discount notice -->
      {%- if settings.show_bulk_discount -%}
        <div class="bulk-discount-notice" style="margin-bottom:20px;">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="flex-shrink:0;color:var(--color-accent);"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>
            <strong>{{ settings.bulk_discount_message }}</strong> — discount applied automatically at checkout
          </span>
        </div>
      {%- endif -%}

      <!-- Metafields: Fabric, Sport, MOQ -->
      {%- if fabric != blank or sport != blank or moq != blank -%}
        <div class="product-meta-grid">
          {%- if fabric != blank -%}
            <div class="product-meta-item">
              <p class="product-meta-label">{{ 'products.fabric_label' | t }}</p>
              <p class="product-meta-value">{{ fabric }}</p>
            </div>
          {%- endif -%}
          {%- if sport != blank -%}
            <div class="product-meta-item">
              <p class="product-meta-label">{{ 'products.sport_label' | t }}</p>
              <p class="product-meta-value">{{ sport }}</p>
            </div>
          {%- endif -%}
          {%- if moq != blank -%}
            <div class="product-meta-item">
              <p class="product-meta-label">{{ 'products.moq_label' | t }}</p>
              <p class="product-meta-value">{{ moq }} pcs</p>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <!-- Product Form -->
      <form method="post" action="/cart/add" data-product-form id="product-form-{{ product.id }}">
        <input type="hidden" name="id" value="{{ current_variant.id }}" id="product-variant-id">

        <!-- Size Selector -->
        {% render 'size-selector', product: product, selected_variant: current_variant %}

        <!-- Quantity -->
        {%- unless price_on_request -%}
          <div style="margin-bottom:20px;">
            <label class="form-label">{{ 'products.quantity_label' | t }}</label>
            <div class="quantity-selector">
              <button type="button" class="quantity-btn" data-qty-minus aria-label="Decrease quantity">−</button>
              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                class="quantity-input"
                aria-label="{{ 'products.quantity_label' | t }}"
              >
              <button type="button" class="quantity-btn" data-qty-plus aria-label="Increase quantity">+</button>
            </div>
          </div>
        {%- endunless -%}

        <!-- Action Buttons -->
        <div class="product-form-actions">
          {%- unless price_on_request -%}
            <button
              type="submit"
              class="btn btn-primary btn-full btn-lg"
              id="product-add-to-cart"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available -%}
                {{ 'products.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.sold_out' | t }}
              {%- endif -%}
            </button>
          {%- endunless -%}

          <a
            href="{{ wa_url }}"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp btn-full"
            id="product-whatsapp-btn"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
            {{ 'product_page.whatsapp_quote' | t }}
          </a>
        </div>
      </form>

      <!-- Tabs -->
      <div class="product-tabs">
        <div class="product-tab-nav" role="tablist">
          <button class="product-tab-btn active" data-tab="tab-details" role="tab" aria-selected="true" id="tab-btn-details">
            {{ 'product_page.tab_details' | t }}
          </button>
          <button class="product-tab-btn" data-tab="tab-customization" role="tab" aria-selected="false" id="tab-btn-custom">
            {{ 'product_page.tab_customization' | t }}
          </button>
          <button class="product-tab-btn" data-tab="tab-delivery" role="tab" aria-selected="false" id="tab-btn-delivery">
            {{ 'product_page.tab_delivery' | t }}
          </button>
        </div>

        <div class="product-tab-content active" id="tab-details" role="tabpanel" aria-labelledby="tab-btn-details">
          {%- if product.description != blank -%}
            <div class="rte">{{ product.description }}</div>
          {%- else -%}
            <p>Premium quality sportswear manufactured at our Meerut facility. Available in sizes S to XXL.</p>
          {%- endif -%}
        </div>

        <div class="product-tab-content" id="tab-customization" role="tabpanel" aria-labelledby="tab-btn-custom">
          <p>{{ 'product_page.customization_content' | t }}</p>
          <a href="{{ wa_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm" style="margin-top:16px;">
            {{ 'product_page.share_design' | t }}
          </a>
        </div>

        <div class="product-tab-content" id="tab-delivery" role="tabpanel" aria-labelledby="tab-btn-delivery">
          <p>{{ 'product_page.delivery_content' | t }}</p>
        </div>
      </div>

    </div>
  </div>

  <!-- Related Products -->
  {%- if section.settings.show_related and product.collections.first != blank -%}
    {%- assign related_collection = product.collections.first -%}
    {%- assign related_products = related_collection.products | where: 'id', '!=', product.id -%}
    {%- if related_collection.products_count > 1 -%}
      <div style="margin-top:64px;">
        <h2 style="font-size:1.5rem;font-weight:700;color:var(--color-primary);margin-bottom:32px;">
          {{ 'products.related_products' | t }}
        </h2>
        <div class="product-grid">
          {%- for rp in related_collection.products limit: 4 -%}
            {%- if rp.id != product.id -%}
              {% render 'product-card', product: rp %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Product Page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Show related products",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Product Page"
    }
  ]
}
{% endschema %}
