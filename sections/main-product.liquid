{% comment %}Section: main-product.liquid — Full product page with gallery, swatches, sticky ATC{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_media = product.featured_media -%}

<div class="product-page">
  <div class="container">

    <!-- Breadcrumb -->
    <nav class="product-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="product-breadcrumb-sep">/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span class="product-breadcrumb-sep">/</span>
      {%- endif -%}
      <span>{{ product.title }}</span>
    </nav>

    <div class="product-layout">

      <!-- ===== GALLERY ===== -->
      <div class="product-gallery">

        <!-- Thumbnails -->
        <div class="product-thumbs" role="list">
          {%- for media in product.media limit: 10 -%}
            <button
              class="product-thumb {% if forloop.first %}is-active{% endif %}"
              data-src="{{ media | image_url: width: 800 }}"
              data-srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w"
              data-variant-img="{{ media.alt | handle }}"
              aria-label="View image {{ forloop.index }}"
              role="listitem"
            >
              <img src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | escape }}" loading="lazy">
            </button>
          {%- endfor -%}
        </div>

        <!-- Main image -->
        <div class="product-main-media">
          <img
            id="product-main-img"
            class="product-main-img"
            src="{{ featured_media | image_url: width: 900 }}"
            srcset="{{ featured_media | image_url: width: 600 }} 600w, {{ featured_media | image_url: width: 900 }} 900w"
            sizes="(max-width: 1024px) 100vw, 50vw"
            alt="{{ featured_media.alt | default: product.title | escape }}"
            loading="eager"
          >
          <button id="product-zoom-btn" class="product-zoom-btn" aria-label="Zoom image">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          </button>
        </div>

      </div>

      <!-- ===== PRODUCT INFO ===== -->
      <div class="product-info">

        {%- if product.vendor -%}
          <p class="product-vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="product-title">{{ product.title }}</h1>

        <!-- Price -->
        <div class="product-price-row">
          <span class="product-price" id="product-price">{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="product-compare-price" id="product-compare-price">{{ current_variant.compare_at_price | money }}</span>
            {%- assign discount_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
            <span class="product-discount-badge">{{ discount_pct }}% OFF</span>
          {%- else -%}
            <span id="product-compare-price" hidden></span>
          {%- endif -%}
        </div>
        <p class="product-moq-note">Minimum order: 5 pieces · Bulk discount at checkout</p>

        <!-- Bulk notice -->
        {%- if settings.show_bulk_discount -%}
          <div class="product-bulk-notice">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:var(--color-accent);flex-shrink:0;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Order {{ settings.bulk_discount_min_qty | default: 5 }}+ pieces → get <strong>{{ settings.bulk_discount_percentage | default: 50 }}% off</strong> at checkout!</span>
          </div>
        {%- endif -%}

        <!-- Variant form -->
        <form
          id="product-form"
          data-atc-form
          data-product-form
          data-variants="{{ product.variants | json | escape }}"
        >
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {%- for option in product.options_with_values -%}
            <div class="product-option">
              <div class="option-label">
                {{ option.name }}
                <span>: <span data-option-selected="{{ option.name }}">{{ option.selected_value }}</span></span>
              </div>

              {%- assign option_name_lower = option.name | downcase -%}
              {%- if option_name_lower == 'color' or option_name_lower == 'colour' -%}
                <!-- Color swatches -->
                <div class="option-swatch-grid">
                  {%- for value in option.values -%}
                    {%- assign color_lower = value | downcase | replace: ' ', '' -%}
                    <button
                      type="button"
                      class="option-swatch {% if value == option.selected_value %}is-active{% endif %}"
                      data-option="{{ option.name }}"
                      data-value="{{ value }}"
                      title="{{ value }}"
                      style="background-color: {{ color_lower }};"
                      aria-label="{{ value }}"
                    ></button>
                  {%- endfor -%}
                </div>
              {%- elsif option_name_lower == 'size' -%}
                <!-- Size buttons -->
                <div class="option-size-grid">
                  {%- for value in option.values -%}
                    {%- assign variant_available = false -%}
                    {%- for variant in product.variants -%}
                      {%- if variant.available and variant.option1 == value or variant.option2 == value or variant.option3 == value -%}
                        {%- assign variant_available = true -%}
                      {%- endif -%}
                    {%- endfor -%}
                    <button
                      type="button"
                      class="option-size-btn {% if value == option.selected_value %}is-active{% endif %} {% unless variant_available %}is-unavailable{% endunless %}"
                      data-option="{{ option.name }}"
                      data-value="{{ value }}"
                    >{{ value }}</button>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <!-- Generic options -->
                <div class="option-size-grid">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="option-size-btn {% if value == option.selected_value %}is-active{% endif %}"
                      data-option="{{ option.name }}"
                      data-value="{{ value }}"
                    >{{ value }}</button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}

          <!-- Qty + ATC -->
          <div class="product-atc-row">
            <div class="qty-selector" role="group" aria-label="Quantity">
              <button type="button" class="qty-btn" data-qty-dec aria-label="Decrease">−</button>
              <input class="qty-input" type="number" name="quantity" value="5" min="1" aria-label="Quantity">
              <button type="button" class="qty-btn" data-qty-inc aria-label="Increase">+</button>
            </div>
            <button
              type="submit"
              class="btn btn-accent btn-lg product-atc-btn"
              data-atc-btn
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available -%}
                Add to Cart
              {%- else -%}
                Sold Out
              {%- endif -%}
            </button>
          </div>

          <!-- WhatsApp quote -->
          <a
            href="https://wa.me/{{ settings.whatsapp_number }}?text=Hello!%20I%20want%20to%20enquire%20about%20{{ product.title | url_encode }}."
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp btn-full"
            style="margin-top:var(--space-2);"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
            {{ 'product_page.whatsapp_quote' | t }}
          </a>

        </form>

        <!-- Accordion Tabs -->
        <div class="product-tabs">
          {%- if product.description != blank -%}
            <div class="product-tab">
              <button class="product-tab-toggle" aria-expanded="false" data-accordion-toggle aria-controls="tab-description">
                Product Details
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
              <div id="tab-description" class="product-tab-content">
                {{ product.description }}
              </div>
            </div>
          {%- endif -%}

          <div class="product-tab">
            <button class="product-tab-toggle" aria-expanded="false" data-accordion-toggle aria-controls="tab-custom">
              Customization
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <div id="tab-custom" class="product-tab-content">
              <p>{{ 'product_page.customization_content' | t }}</p>
            </div>
          </div>

          <div class="product-tab">
            <button class="product-tab-toggle" aria-expanded="false" data-accordion-toggle aria-controls="tab-delivery">
              Delivery & Returns
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <div id="tab-delivery" class="product-tab-content">
              <p>{{ 'product_page.delivery_content' | t }}</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_related", "label": "Show related products", "default": true }
  ],
  "presets": [{ "name": "Product" }]
}
{% endschema %}
