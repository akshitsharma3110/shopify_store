{% comment %}
  Section: main-page.liquid
  Generic page template
{% endcomment %}

{%- render 'breadcrumb' -%}

<div class="container" style="padding-top:40px;padding-bottom:80px;max-width:860px;" id="page-content">
  <h1 style="font-size:clamp(1.5rem,3vw,2rem);font-weight:800;color:var(--color-primary);margin-bottom:24px;">{{ page.title }}</h1>
  <div class="rte" style="font-size:15px;line-height:1.75;color:var(--color-text);">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": [],
  "presets": [
    {
      "name": "Page"
    }
  ]
}
{% endschema %}
