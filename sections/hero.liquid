{% comment %}Section: hero.liquid — Full-viewport editorial fashion hero{% endcomment %}

<section class="hero" id="hero-section">
  {%- if section.settings.image != blank -%}
    <img
      class="hero-bg"
      src="{{ section.settings.image | image_url: width: 1920 }}"
      srcset="{{ section.settings.image | image_url: width: 800 }} 800w,
              {{ section.settings.image | image_url: width: 1200 }} 1200w,
              {{ section.settings.image | image_url: width: 1920 }} 1920w"
      sizes="100vw"
      alt="{{ section.settings.image.alt | default: shop.name }}"
      loading="eager"
      fetchpriority="high"
    >
  {%- endif -%}
  <div class="hero-gradient"></div>

  <div class="container">
    <div class="hero-content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="hero-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      <h1 class="hero-title">
        {%- assign heading_parts = section.settings.heading | split: '[orange]' -%}
        {%- for part in heading_parts -%}
          {%- assign end_parts = part | split: '[/orange]' -%}
          {%- if forloop.index > 1 -%}
            <span class="accent">{{ end_parts[0] }}</span>{{ end_parts[1] }}
          {%- else -%}
            {{ part }}
          {%- endif -%}
        {%- endfor -%}
      </h1>

      {%- if section.settings.subheading != blank -%}
        <p class="hero-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="hero-actions">
        {%- if section.settings.cta1_label != blank -%}
          <a href="{{ section.settings.cta1_url | default: '/collections/all' }}" class="btn btn-white btn-lg">
            {{ section.settings.cta1_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a href="{{ section.settings.cta2_url | default: '/pages/custom-order' }}" class="btn btn-outline-white btn-lg">
            {{ section.settings.cta2_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="hero-scroll" aria-hidden="true">
    <span>Scroll</span>
    <div class="hero-scroll-line"></div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "ACCTIVE Sports Industries — Since 2003" },
    { "type": "text", "id": "heading", "label": "Heading (wrap [orange]text[/orange] for accent)", "default": "Premium Sportswear, [orange]Factory Direct[/orange]" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Custom-made sportswear for teams, clubs, and retailers across India. Order from 5 pieces." },
    { "type": "text", "id": "cta1_label", "label": "Primary CTA label", "default": "Shop Sportswear" },
    { "type": "url", "id": "cta1_url", "label": "Primary CTA URL" },
    { "type": "text", "id": "cta2_label", "label": "Secondary CTA label", "default": "Get Custom Quote" },
    { "type": "url", "id": "cta2_url", "label": "Secondary CTA URL" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
