<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0">
  <meta name="theme-color" content="#0B1F33">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {%- if page_title == shop.name -%}
      {{ page_title }} | Premium Sportswear Manufacturer, Meerut
    {%- else -%}
      {{ page_title }} | {{ shop.name }}
    {%- endif -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {% render 'meta-tags' %}

  <!-- Preconnect for performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Theme CSS -->
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <!-- CSS variables from settings -->
  <style>
    :root {
      --color-primary: {{ settings.color_primary }};
      --color-accent: {{ settings.color_accent }};
      --color-accent-hover: {{ settings.color_accent_hover }};
      --color-bg: {{ settings.color_background }};
      --color-card-bg: {{ settings.color_card_bg }};
      --color-text: {{ settings.color_text }};
      --color-muted: {{ settings.color_muted }};
      --color-border: {{ settings.color_border }};
      --container-max: {{ settings.page_width }}px;
    }
  </style>

  <!-- Bulk discount data attributes (used by JS) -->
  <script>
    document.documentElement.dataset.bulkMin = {{ settings.bulk_discount_min_qty | default: 5 }};
    document.documentElement.dataset.bulkPct = {{ settings.bulk_discount_percentage | default: 50 }};
    document.documentElement.classList.remove('no-js');
  </script>

  {{ content_for_header }}
</head>

<body id="{{ page_title | handle }}" class="template-{{ template.name }}">

  <a href="#MainContent" class="visually-hidden skip-to-content-link btn">
    {{- 'general.accessibility.skip_to_content' | t -}}
  </a>

  {%- sections 'header-group' -%}

  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- sections 'footer-group' -%}

  <!-- WhatsApp Float Button -->
  {%- render 'whatsapp-button', style: 'float' -%}

  <!-- Cart Drawer -->
  <div id="cart-drawer-overlay" class="cart-drawer-overlay" aria-hidden="true"></div>
  <div id="cart-drawer" class="cart-drawer" role="dialog" aria-label="{{ 'cart.title' | t }}" aria-modal="true">
    <div class="cart-drawer-header">
      <h2 class="cart-drawer-title">{{ 'cart.title' | t }}</h2>
      <button class="cart-drawer-close" data-cart-close aria-label="{{ 'general.accessibility.close_cart' | t }}">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    {%- if settings.show_bulk_discount -%}
      <div class="bulk-discount-notice" data-bulk-notice style="margin:12px 24px 0;">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="flex-shrink:0;color:var(--color-accent);"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span data-bulk-text>{{ settings.bulk_discount_message }}</span>
      </div>
    {%- endif -%}

    <div class="cart-drawer-body">
      <!-- Populated by JS -->
      <div class="cart-empty-state">
        <svg class="cart-empty-icon" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"/>
        </svg>
        <h3 class="cart-empty-title">{{ 'cart.empty' | t }}</h3>
        <p class="cart-empty-desc">{{ 'cart.empty_message' | t }}</p>
        <a href="/collections/all" class="btn btn-primary" onclick="closeCartDrawer()">Shop Now</a>
      </div>
    </div>

    <div class="cart-drawer-footer" style="display:none;">
      <div class="cart-subtotal-row">
        <span class="cart-subtotal-label">{{ 'cart.subtotal' | t }}</span>
        <span class="cart-subtotal-value" data-cart-subtotal>{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-taxes-note">{{ 'cart.taxes_note' | t }}</p>
      {%- if settings.show_order_note -%}
        <details style="margin-bottom:12px;">
          <summary style="font-size:13px;color:var(--color-muted);cursor:pointer;margin-bottom:8px;">{{ 'cart.order_note_label' | t }}</summary>
          <textarea id="cart-note" class="form-textarea" rows="3" placeholder="{{ 'cart.order_note_placeholder' | t }}" style="font-size:13px;"></textarea>
        </details>
      {%- endif -%}
      <a href="/checkout" class="btn btn-primary btn-full" id="cart-checkout-btn">{{ 'cart.checkout' | t }}</a>
      <a href="/collections/all" class="btn btn-secondary btn-full" style="margin-top:8px;" onclick="closeCartDrawer()">{{ 'cart.continue_shopping' | t }}</a>
    </div>
  </div>

  <!-- Search Modal -->
  <div id="search-modal" class="search-modal" role="dialog" aria-label="Search" aria-modal="true">
    <div class="search-modal-box">
      <form class="search-form" action="/search" method="get">
        <input
          type="search"
          name="q"
          class="form-input"
          placeholder="{{ 'general.search.search_placeholder' | t }}"
          aria-label="{{ 'general.search.search' | t }}"
          autocomplete="off"
          id="search-input"
        >
        <input type="hidden" name="type" value="product">
        <button type="submit" class="btn btn-primary" aria-label="{{ 'general.search.search' | t }}">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <button type="button" class="btn btn-secondary" data-search-close aria-label="{{ 'general.search.close' | t }}">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </form>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <nav id="mobile-nav" class="mobile-nav" role="navigation" aria-label="Mobile menu">
    <div class="mobile-nav-header">
      <a href="/" class="header-logo" onclick="document.getElementById('mobile-nav').classList.remove('is-open'); document.body.style.overflow='';">
        {%- if settings.logo != blank -%}
          <img src="{{ settings.logo | image_url: width: 140 }}" alt="{{ shop.name }}" width="140" height="40" loading="lazy">
        {%- else -%}
          <span class="header-logo-text"><span>ACCTIVE</span> Sports</span>
        {%- endif -%}
      </a>
      <button id="mobile-nav-close" class="header-icon-btn" aria-label="Close menu">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="mobile-nav-links">
      {%- for link in linklists['main-menu'].links -%}
        <a href="{{ link.url }}" class="mobile-nav-link"
          onclick="document.getElementById('mobile-nav').classList.remove('is-open'); document.body.style.overflow='';">
          {{ link.title }}
        </a>
      {%- endfor -%}
      <a href="{{ settings.custom_order_url | default: '/pages/custom-order' }}" class="btn btn-primary" style="margin-top:16px;">
        {{ settings.custom_order_label | default: 'Custom Order' }}
      </a>
    </div>
    <div style="margin-top:auto;padding-top:24px;border-top:1px solid var(--color-border);">
      {%- render 'whatsapp-button', style: 'inline' -%}
    </div>
  </nav>

  <!-- Theme JS -->
  <script src="{{ 'theme.js' | asset_url }}" defer></script>

</body>
</html>
