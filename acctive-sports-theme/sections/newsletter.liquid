{% comment %}
  Section: newsletter.liquid
{% endcomment %}

<section class="newsletter-section" id="newsletter-section">
  <div class="container">
    <h2 class="newsletter-heading">{{ section.settings.heading }}</h2>
    <p class="newsletter-sub">{{ section.settings.subheading }}</p>

    {%- form 'customer', id: 'newsletter-form', data-newsletter: '' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form">
        <input
          type="email"
          name="contact[email]"
          class="form-input"
          placeholder="{{ section.settings.placeholder }}"
          required
          autocomplete="email"
          id="newsletter-email"
          aria-label="{{ section.settings.placeholder }}"
        >
        <button type="submit" class="btn btn-primary" id="newsletter-submit">
          {{ section.settings.submit_label }}
        </button>
      </div>
      {%- if form.posted_successfully? -%}
        <p style="color:var(--color-teal);margin-top:12px;font-size:14px;">{{ 'newsletter.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}

    <p style="font-size:12px;color:rgba(255,255,255,0.4);margin-top:12px;">
      We respect your privacy. Unsubscribe anytime.
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the Loop"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "New arrivals, bulk deals, and sportswear inspiration — straight to your inbox."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
